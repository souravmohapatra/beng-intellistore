[Unit]
Description=Intellistore laptop worker (polls the mini-PC app for released jobs)
After=network-online.target docker.service snap.docker.dockerd.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The runtime file is written by beng-laptop-setup.sh and is root-owned 0600.
EnvironmentFile=/etc/beng-intellistore-worker/runtime.env
# /snap/bin keeps the unit working when the laptop's Docker comes from the snap.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStartPre=/usr/bin/test -n "${DOCKER_HOST}"
ExecStartPre=/usr/bin/test -n "${INTELLISTORE_COMPOSE_DIR}"
ExecStartPre=/usr/bin/test -n "${INTELLISTORE_APP_URL}"
ExecStartPre=/usr/bin/test -f "${INTELLISTORE_COMPOSE_DIR}/compose.worker.yaml"
ExecStart=/usr/bin/env docker --host=${DOCKER_HOST} compose --env-file /dev/null --project-directory=${INTELLISTORE_COMPOSE_DIR} -f ${INTELLISTORE_COMPOSE_DIR}/compose.worker.yaml up -d --wait
ExecStop=/usr/bin/env docker --host=${DOCKER_HOST} compose --env-file /dev/null --project-directory=${INTELLISTORE_COMPOSE_DIR} -f ${INTELLISTORE_COMPOSE_DIR}/compose.worker.yaml stop worker
# A first start may have to build the worker image.
TimeoutStartSec=20min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
