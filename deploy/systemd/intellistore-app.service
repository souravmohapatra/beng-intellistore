[Unit]
Description=IntelliStore application stack (PostgreSQL and Gunicorn)
After=network-online.target docker.service snap.docker.dockerd.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/beng-intellistore/runtime.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStartPre=/usr/bin/test -n "${DOCKER_HOST}"
ExecStartPre=/usr/bin/test -n "${INTELLISTORE_COMPOSE_DIR}"
ExecStart=/usr/bin/env docker --host=${DOCKER_HOST} compose --env-file /dev/null --project-directory=${INTELLISTORE_COMPOSE_DIR} -f ${INTELLISTORE_COMPOSE_DIR}/compose.production.yaml up -d --wait app
ExecStop=/usr/bin/env docker --host=${DOCKER_HOST} compose --env-file /dev/null --project-directory=${INTELLISTORE_COMPOSE_DIR} -f ${INTELLISTORE_COMPOSE_DIR}/compose.production.yaml stop app postgres
TimeoutStartSec=15min
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
