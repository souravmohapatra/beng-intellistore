[Unit]
Description=Release due Intellistore processing jobs

[Service]
Type=oneshot
EnvironmentFile=/etc/beng-intellistore/runtime.env
ExecStartPre=/usr/bin/test -n "${DOCKER_HOST}"
ExecStartPre=/usr/bin/test -n "${INTELLISTORE_COMPOSE_DIR}"
ExecStart=docker --host=${DOCKER_HOST} compose --project-directory=${INTELLISTORE_COMPOSE_DIR} -f ${INTELLISTORE_COMPOSE_DIR}/compose.production.yaml run --rm release-jobs
TimeoutStartSec=5min
